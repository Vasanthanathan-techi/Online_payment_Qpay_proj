{
  "info": {
    "name": "QPay End-to-End Acceptance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "local.merchant@qpay.test" },
    { "key": "password", "value": "QPayLocal123!", "type": "secret" },
    { "key": "webhookSecret", "value": "local-webhook-secret-change-me", "type": "secret" }
  ],
  "item": [
    {
      "name": "1 - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}" },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('login succeeds', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.collectionVariables.set('accessToken', body.accessToken);",
        "pm.collectionVariables.set('runId', Date.now().toString());"
      ] } }]
    },
    {
      "name": "2 - Create Merchant",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"legalName\":\"QPay Postman Pvt Ltd\",\"displayName\":\"QPay Postman\",\"registrationNumber\":\"POSTMAN-{{runId}}\",\"countryCode\":\"IN\",\"defaultCurrency\":\"INR\"}" },
        "url": "{{baseUrl}}/api/v1/merchants"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('merchant created', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('merchantId', pm.response.json().id);"
      ] } }]
    },
    {
      "name": "3 - Create Wallet",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"ownerType\":\"MERCHANT\",\"ownerId\":\"{{merchantId}}\",\"currency\":\"INR\"}" },
        "url": "{{baseUrl}}/api/v1/wallets"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('wallet created', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('walletId', pm.response.json().id);"
      ] } }]
    },
    {
      "name": "4 - Create Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Merchant-Id", "value": "{{merchantId}}" },
          { "key": "Idempotency-Key", "value": "postman-{{runId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"walletId\":\"{{walletId}}\",\"merchantReference\":\"ORDER-{{runId}}\",\"amount\":{\"amountMinor\":10000,\"currency\":\"INR\"},\"paymentMethod\":{\"type\":\"UPI\"},\"returnUrl\":\"https://merchant.test/payment-return\"}" },
        "url": "{{baseUrl}}/api/v1/payments"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('payment requires action', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('REQUIRES_ACTION'); });",
        "const body = pm.response.json();",
        "pm.collectionVariables.set('paymentId', body.id);",
        "pm.collectionVariables.set('providerReference', body.providerReference);"
      ] } }]
    },
    {
      "name": "5 - Provider Success Webhook",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "const timestamp = Math.floor(Date.now() / 1000).toString();",
          "const body = '{}';",
          "const signature = CryptoJS.HmacSHA256(timestamp + '.' + body, pm.collectionVariables.get('webhookSecret')).toString(CryptoJS.enc.Hex);",
          "pm.collectionVariables.set('webhookTimestamp', timestamp);",
          "pm.collectionVariables.set('webhookSignature', signature);"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('payment succeeds', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('SUCCEEDED'); });"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Provider-Event-Id", "value": "evt-{{runId}}" },
          { "key": "X-Provider-Reference", "value": "{{providerReference}}" },
          { "key": "X-Provider-Status", "value": "SUCCEEDED" },
          { "key": "X-Provider-Timestamp", "value": "{{webhookTimestamp}}" },
          { "key": "X-Provider-Signature", "value": "{{webhookSignature}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/api/v1/webhooks/providers/payments/STUB"
      }
    },
    {
      "name": "6 - Get Completed Payment",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('stored payment is successful', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('SUCCEEDED'); });"
      ] } }]
    }
  ]
}
